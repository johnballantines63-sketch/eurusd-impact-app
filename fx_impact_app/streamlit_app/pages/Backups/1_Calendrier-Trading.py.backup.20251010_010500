def check_upcoming_high_impact_events(df: pd.DataFrame) -> list:
    """
    Vérifie les événements High Impact à venir dans les prochaines heures.
    """
    # S'assurer que now est timezone-aware
    now = pd.Timestamp.now(tz='UTC')
    lookback = now + timedelta(hours=ALERT_LOOKBACK_HOURS)
    
    # Convertir event_datetime en UTC si nécessaire
    if df['event_datetime'].dt.tz is None:
        df_copy = df.copy()
        df_copy['event_datetime'] = pd.to_datetime(df_copy['event_datetime'], utc=True)
    else:
        df_copy = df.copy()
        df_copy['event_datetime'] = df_copy['event_datetime'].dt.tz_convert('UTC')
    
    # Filtrer événements futurs High Impact
    df_upcoming = df_copy[
        (df_copy['event_datetime'] >= now) &
        (df_copy['event_datetime'] <= lookback) &
        (df_copy['impact'] == 'High')
    ].sort_values('event_datetime')
    
    alerts = []
    
    for _, event in df_upcoming.iterrows():
        time_until = event['event_datetime'] - now
        hours_until = time_until.total_seconds() / 3600
        
        alerts.append({
            'event_name': event['event_name'],
            'currency': event['currency'],
            'datetime': event['event_datetime'],
            'hours_until': hours_until,
            'estimate': event.get('estimate'),
            'previous': event.get('previous')
        })
    
    return alerts


def display_alerts_panel(alerts: list):
    """
    Affiche le panneau d'alertes.
    """
    if not alerts:
        st.success("✅ Aucun événement High Impact dans les prochaines 48h")
        return
    
    st.warning(f"🔔 **{len(alerts)} événement(s) High Impact à venir**")
    
    for alert in alerts:
        hours = alert['hours_until']
        
        # Urgence
        if hours < 1:
            urgency = "🔴 IMMINENT"
            urgency_color = "red"
        elif hours < 6:
            urgency = "🟠 PROCHE"
            urgency_color = "orange"
        elif hours < 24:
            urgency = "🟡 AUJOURD'HUI"
            urgency_color = "yellow"
        else:
            urgency = "🟢 DEMAIN+"
            urgency_color = "green"
        
        with st.container():
            col1, col2, col3 = st.columns([1, 4, 2])
            
            with col1:
                st.markdown(f"**{urgency}**")
            
            with col2:
                currency_emoji = "🇪🇺" if alert['currency'] == 'EUR' else "🇺🇸"
                st.write(f"{currency_emoji} **{alert['event_name']}**")
                st.caption(alert['datetime'].strftime('%Y-%m-%d %H:%M'))
            
            with col3:
                st.metric("Dans", f"{hours:.1f}h")
            
            st.divider()


