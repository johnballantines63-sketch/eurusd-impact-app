def create_timeline_chart(df: pd.DataFrame) -> go.Figure:
    """
    Crée un graphique timeline interactif des événements.
    """
    if df.empty:
        return None
    
    df_chart = df.copy()
    df_chart['date'] = df_chart['event_datetime'].dt.date
    df_chart['time'] = df_chart['event_datetime'].dt.strftime('%H:%M')
    
    # Couleurs par impact
    color_map = {
        'High': '#FF4B4B',
        'Medium': '#FFA500',
        'Low': '#00CC00'
    }
    
    # Symboles par devise - gérer les NaN
    symbol_map = {
        'EU': 'circle',
        'US': 'square',
        'EA': 'diamond'
    }
    
    df_chart['color'] = df_chart['impact'].map(color_map).fillna('#CCCCCC')
    df_chart['symbol'] = df_chart['currency'].map(symbol_map).fillna('circle')
    
    # Filtrer les lignes avec des valeurs valides uniquement
    df_chart = df_chart[df_chart['currency'].notna()].copy()
    
    fig = go.Figure()
    
    # Ajout des événements par impact
    for impact in ['High', 'Medium', 'Low']:
        df_impact = df_chart[df_chart['impact'] == impact]
        
        if not df_impact.empty:
            fig.add_trace(go.Scatter(
                x=df_impact['event_datetime'],
                y=df_impact['impact'],
                mode='markers+text',
                name=f'{impact} Impact',
                marker=dict(
                    size=15,
                    color=color_map[impact],
                    symbol=df_impact['symbol'].tolist(),  # Convertir en liste
                    line=dict(width=2, color='white')
                ),
                text=df_impact['time'],
                textposition='top center',
                textfont=dict(size=9),
                hovertemplate='<b>%{customdata[0]}</b><br>' +
                              'Time: %{customdata[1]}<br>' +
                              'Currency: %{customdata[2]}<br>' +
                              'Impact: %{y}<br>' +
                              '<extra></extra>',
                customdata=df_impact[['event_name', 'time', 'currency']]
            ))
    
    # Mise en forme
    fig.update_layout(
        title='📊 Timeline des Événements',
        xaxis_title='Date & Heure',
        yaxis_title='Impact',
        hovermode='closest',
        height=400,
        showlegend=True,
        plot_bgcolor='rgba(0,0,0,0)',
        paper_bgcolor='rgba(0,0,0,0)',
        yaxis=dict(
            categoryorder='array',
            categoryarray=['Low', 'Medium', 'High']
        )
    )
    
    return fig


def create_impact_distribution_chart(df: pd.DataFrame) -> go.Figure:
    """
    Crée un graphique de distribution des impacts par devise.
    """
    if df.empty:
        return None
    
    # Comptage par impact et devise
    impact_counts = df.groupby(['impact', 'currency']).size().reset_index(name='count')
    
    fig = go.Figure()
    
    colors = {'EU': '#003399', 'US': '#FF4B4B', 'EA': '#0066CC'}
    
    for currency in ['EU', 'US', 'EA']:
        df_currency = impact_counts[impact_counts['currency'] == currency]
        
        fig.add_trace(go.Bar(
            name=currency,
            x=df_currency['impact'],
            y=df_currency['count'],
            marker_color=colors[currency],
            text=df_currency['count'],
            textposition='auto',
        ))
    
    fig.update_layout(
        title='📊 Distribution Impact par Devise',
        xaxis_title='Impact',
        yaxis_title='Nombre d\'événements',
        barmode='group',
        height=300,
        showlegend=True,
        plot_bgcolor='rgba(0,0,0,0)',
        paper_bgcolor='rgba(0,0,0,0)',
        xaxis=dict(
            categoryorder='array',
            categoryarray=['High', 'Medium', 'Low']
        )
    )
    
    return fig


def create_hourly_heatmap(df: pd.DataFrame) -> go.Figure:
    """
    Crée une heatmap des événements par heure et jour.
    """
    if df.empty:
        return None
    
    df_heat = df.copy()
    df_heat['hour'] = df_heat['event_datetime'].dt.hour
    df_heat['day_name'] = df_heat['event_datetime'].dt.day_name()
    
    # Comptage
    heatmap_data = df_heat.groupby(['day_name', 'hour']).size().reset_index(name='count')
    
    # Pivot pour heatmap
    pivot = heatmap_data.pivot(index='day_name', columns='hour', values='count').fillna(0)
    
    # Ordre des jours
    days_order = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
    pivot = pivot.reindex([d for d in days_order if d in pivot.index])
    
    fig = go.Figure(data=go.Heatmap(
        z=pivot.values,
        x=pivot.columns,
        y=pivot.index,
        colorscale='Reds',
        text=pivot.values,
        texttemplate='%{text}',
        textfont={"size": 10},
        hovertemplate='Jour: %{y}<br>Heure: %{x}h<br>Événements: %{z}<extra></extra>'
    ))
    
    fig.update_layout(
        title='🕐 Heatmap Événements par Jour & Heure',
        xaxis_title='Heure',
        yaxis_title='Jour',
        height=350,
        plot_bgcolor='rgba(0,0,0,0)',
        paper_bgcolor='rgba(0,0,0,0)'
    )
    
    return fig


